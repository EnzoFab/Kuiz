# Kuiz environment — copy to .env and fill in. See docs/deploy.md.

# --- Server (@kuiz/server) ---
# Postgres connection. Enables the template catalog (GET /catalog) + seeding.
# Omit entirely to run the realtime server without a DB (demo game only).
DATABASE_URL=postgresql://user:password@host:5432/kuiz

# Port the server listens on (default 3001).
PORT=3001

# The web app's origin, for CORS (Socket.IO + GET /catalog). Defaults to "*" in dev.
# In production set this to your deployed web origin, e.g. https://kuiz.example.com
CORS_ORIGIN=*

# --- Web (@kuiz/web, build-time / Vite) ---
# The realtime server URL the web app connects to. Baked in at `vite build` time.
VITE_SERVER_URL=http://localhost:3001
